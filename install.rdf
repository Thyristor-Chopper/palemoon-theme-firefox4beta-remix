<?xml version="1.0"?>

<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:em="http://www.mozilla.org/2004/em-rdf#">
	<Description about="urn:mozilla:install-manifest">
		<em:id>firefox4beta-remix@gecchopper</em:id>
		<em:version>4.2.0</em:version>
		<em:name>Light Moon</em:name>
		<em:description>Firefox 4.0 Beta theme with some custom modifications.</em:description>
		<em:creator>길고</em:creator>
		<em:type>4</em:type>
		<em:internalName>firefox4brmx</em:internalName>
		<em:skinnable>true</em:skinnable>

		<!-- Pale Moon -->
		<em:targetApplication>
			<Description>
				<em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
				<em:minVersion>26.0.0</em:minVersion>
				<em:maxVersion>35.*</em:maxVersion>
			</Description>
		</em:targetApplication>
	</Description>
</RDF>
